<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Installer definition for no-watermark.

  Build it with the WiX Toolset v5 command line; the exact commands are in
  the "Building the packages" section of README.md. They are not repeated
  here because an XML comment may not contain a double hyphen, and every one
  of those commands is full of them.

  WiX v5 is pinned deliberately. From v6 onwards the toolset requires
  accepting the Open Source Maintenance Fee EULA, which is a licensing
  decision for whoever is building rather than something to bake into a
  repository.

  Every path below is relative to the repository root, so run the build from
  there, and build the release profile first.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Overridden from the command line with: wix build -d Version=1.2.3 -->
  <?ifndef Version ?>
  <?define Version = "1.0.0" ?>
  <?endif ?>

  <Package
      Name="no-watermark"
      Manufacturer="Giacomo Giordano"
      Version="$(var.Version)"
      UpgradeCode="326B145A-2305-4A14-A053-F12CD387839F"
      Scope="perMachine"
      Compressed="yes">

    <SummaryInformation
        Description="Detect and strip invisible Unicode watermarks from AI chat output"
        Manufacturer="Giacomo Giordano" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of no-watermark is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/BitJacker/no-watermark" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Licence text shown by the installer UI. -->
    <WixVariable Id="WixUILicenseRtf" Value="packaging\wix\license.rtf" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="no-watermark" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="no-watermark" Level="1"
             Description="The desktop application and the command line tool.">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <ComponentGroup Id="AppComponents">
      <!-- The Start Menu entry is an advertised shortcut nested inside the
           file it points at. That keeps the package uniformly per machine: a
           standalone shortcut component would need a per user registry value
           as its KeyPath, mixing per user and per machine data in a single
           component and failing ICE57 validation. -->
      <Component Id="GuiExe" Directory="INSTALLFOLDER">
        <File Id="NoWatermarkGuiExe"
              Source="target\release\no-watermark-gui.exe"
              KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="no-watermark"
                    Description="Strip invisible watermarks from AI chat output"
                    Icon="AppIcon"
                    Advertise="yes" />
        </File>
      </Component>

      <!-- The CLI directory is put on PATH so `no-watermark` works in any
           shell after installation. -->
      <Component Id="CliExe" Directory="INSTALLFOLDER">
        <File Id="NoWatermarkExe"
              Source="target\release\no-watermark.exe"
              KeyPath="yes" />
        <Environment Id="PathEntry"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
      </Component>

      <Component Id="Docs" Directory="INSTALLFOLDER">
        <File Id="ReadmeFile" Source="README.md" KeyPath="yes" />
        <File Id="LicenseFile" Source="LICENSE" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
